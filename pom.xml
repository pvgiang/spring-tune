<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.winkytek.springtune</groupId>
    <artifactId>springtune-parent</artifactId>
    <version>0.4.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>SpringTune</name>
    <description>Spring Boot config safety and explainable tuning recommendations.</description>
    <url>https://github.com/pvgiang/spring-tune</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <!-- Required by Maven Central (with name, description, url, licenses). Kept in flattened POMs (flattenMode ossrh). -->
    <developers>
        <developer>
            <id>pvgiang</id>
            <name>Giang Pham</name>
            <url>https://github.com/pvgiang</url>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false"
         child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/pvgiang/spring-tune.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/pvgiang/spring-tune.git</developerConnection>
        <url>https://github.com/pvgiang/spring-tune</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub</system>
        <url>https://github.com/pvgiang/spring-tune/issues</url>
    </issueManagement>

    <modules>
        <module>springtune-model</module>
        <module>springtune-check-engine</module>
        <module>springtune-check-cli</module>
        <module>springtune-maven-plugin</module>
        <module>springtune-gradle-plugin</module>
        <module>springtune-gradle-plugin-marker</module>
        <module>springtune-gradle-plugin-tests</module>
        <module>springtune-spring-boot-autoconfigure</module>
        <module>springtune-spring-boot-starter</module>
        <module>springtune-limiter</module>
        <module>springtune-loadtests</module>
        <module>springtune-samples/broken-config</module>
    </modules>

    <properties>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Override with -Dspring-boot.version=3.5.16 to run the 3.x compatibility check. -->
        <spring-boot.version>4.1.2</spring-boot.version>
        <jackson2.version>2.22.4</jackson2.version>
        <javaparser.version>3.28.2</javaparser.version>
        <picocli.version>4.7.7</picocli.version>
        <maven-api.version>3.9.11</maven-api.version>
        <maven-plugin-tools.version>3.15.1</maven-plugin-tools.version>
        <!-- Compile-only Gradle API (Maven Central mirror of gradleApi()); the plugin is tested on real Gradle 8.x and 9.x. -->
        <gradle-api.version>8.11.1</gradle-api.version>

        <!-- Release to Maven Central (profile 'release', see docs/releasing.md). -->
        <jreleaser.version>1.26.0</jreleaser.version>
        <!-- Staging repository written by 'mvn deploy -Prelease -DaltDeploymentRepository=...' and read by JReleaser. -->
        <springtune.staging.dir>${maven.multiModuleProjectDirectory}/target/staging-repo</springtune.staging.dir>
        <!-- UPLOAD: validate and stop, a human presses Publish on central.sonatype.com. FULL: publish automatically. -->
        <springtune.central.stage>UPLOAD</springtune.central.stage>
        <!-- CycloneDX SBOMs, release profile only (docs/releasing.md#sboms). -->
        <cyclonedx-maven-plugin.version>2.9.3</cyclonedx-maven-plugin.version>

        <!-- Adaptive limit algorithms for springtune-limiter (Apache 2.0, one runtime dependency: slf4j-api). -->
        <concurrency-limits.version>0.5.4</concurrency-limits.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson2.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.winkytek.springtune</groupId>
                <artifactId>springtune-model</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.winkytek.springtune</groupId>
                <artifactId>springtune-check-engine</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.winkytek.springtune</groupId>
                <artifactId>springtune-spring-boot-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.winkytek.springtune</groupId>
                <artifactId>springtune-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.winkytek.springtune</groupId>
                <artifactId>springtune-limiter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.netflix.concurrency-limits</groupId>
                <artifactId>concurrency-limits-core</artifactId>
                <version>${concurrency-limits.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>
            <dependency>
                <groupId>info.picocli</groupId>
                <artifactId>picocli</artifactId>
                <version>${picocli.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.14.0</version>
                    <configuration>
                        <parameters>true</parameters>
                        <compilerArgs>
                            <arg>-Xlint:all,-processing,-serial</arg>
                        </compilerArgs>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>3.5.3</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>3.1.4</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-clean-plugin</artifactId>
                    <version>3.4.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-plugin-plugin</artifactId>
                    <version>${maven-plugin-tools.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-invoker-plugin</artifactId>
                    <version>3.10.1</version>
                </plugin>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.14</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.1</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.12.0</version>
                </plugin>
                <plugin>
                    <groupId>org.jreleaser</groupId>
                    <artifactId>jreleaser-maven-plugin</artifactId>
                    <version>${jreleaser.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.cyclonedx</groupId>
                    <artifactId>cyclonedx-maven-plugin</artifactId>
                    <version>${cyclonedx-maven-plugin.version}</version>
                </plugin>
                <!--
                  Consumer POMs without parent or BOM imports, with explicit versions. Applied to the modules Gradle
                  resolves (the plugin, its marker and the engine): resolving them then needs only their own files
                  instead of springtune-parent plus the Spring Boot, Jackson, ... BOMs it imports.
                -->
                <plugin>
                    <groupId>org.codehaus.mojo</groupId>
                    <artifactId>flatten-maven-plugin</artifactId>
                    <version>1.8.0</version>
                    <configuration>
                        <flattenMode>ossrh</flattenMode>
                        <updatePomFile>true</updatePomFile>
                    </configuration>
                    <executions>
                        <execution>
                            <id>flatten</id>
                            <phase>process-resources</phase>
                            <goals>
                                <goal>flatten</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>flatten-clean</id>
                            <phase>clean</phase>
                            <goals>
                                <goal>clean</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <!-- LICENSE and NOTICE in META-INF of every jar (Apache 2.0, section 4). -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-legal-files</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/META-INF</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${maven.multiModuleProjectDirectory}</directory>
                                    <includes>
                                        <include>LICENSE</include>
                                        <include>NOTICE</include>
                                    </includes>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
          Maven Central release (docs/releasing.md). Normal builds never activate it.
            1. mvn -Prelease deploy -DskipTests -Dinvoker.skip -DaltDeploymentRepository=staging::file:target/staging-repo
               adds -sources and -javadoc jars to every published module and stages everything in target/staging-repo.
            2. mvn -Prelease -N jreleaser:deploy
               signs (GPG key from JRELEASER_GPG_* env), adds checksums, checks Central's rules and uploads the bundle
               (JRELEASER_MAVENCENTRAL_USERNAME/PASSWORD). Add -Djreleaser.dry.run=true to stop before uploading.
          It also writes CycloneDX SBOMs: <artifactId>-<version>-cyclonedx.json per published module (attached, so it is
          staged and deployed with the jars) and target/springtune-<version>-sbom.cyclonedx.json for the whole release
          (not attached; release.yml puts it on the GitHub Release). Modules with maven.deploy.skip get no SBOM.
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <doclint>none</doclint>
                            <quiet>true</quiet>
                            <release>${maven.compiler.release}</release>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.cyclonedx</groupId>
                        <artifactId>cyclonedx-maven-plugin</artifactId>
                        <configuration>
                            <outputFormat>json</outputFormat>
                            <!-- Runtime view: what a consumer gets (compile + runtime), not test or build tooling. -->
                            <includeTestScope>false</includeTestScope>
                            <includeProvidedScope>false</includeProvidedScope>
                            <includeSystemScope>false</includeSystemScope>
                            <!-- Samples, load tests, Gradle plugin tests and benchmarks are never published. -->
                            <skipNotDeployed>true</skipNotDeployed>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sbom-per-module</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>makeBom</goal>
                                </goals>
                            </execution>
                            <execution>
                                <!-- One SBOM for the whole release, for the GitHub Release; not attached (no extra
                                     springtune-parent artifact on Central). -->
                                <id>sbom-aggregate</id>
                                <phase>package</phase>
                                <inherited>false</inherited>
                                <goals>
                                    <goal>makeAggregateBom</goal>
                                </goals>
                                <configuration>
                                    <outputName>springtune-${project.version}-sbom.cyclonedx</outputName>
                                    <skipAttach>true</skipAttach>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.jreleaser</groupId>
                        <artifactId>jreleaser-maven-plugin</artifactId>
                        <inherited>false</inherited>
                        <configuration>
                            <jreleaser>
                                <signing>
                                    <pgp>
                                        <active>ALWAYS</active>
                                        <armored>true</armored>
                                        <mode>MEMORY</mode>
                                    </pgp>
                                </signing>
                                <deploy>
                                    <maven>
                                        <mavenCentral>
                                            <sonatype>
                                                <active>ALWAYS</active>
                                                <url>https://central.sonatype.com/api/v1/publisher</url>
                                                <stagingRepositories>${springtune.staging.dir}</stagingRepositories>
                                                <stage>${springtune.central.stage}</stage>
                                                <applyMavenCentralRules>true</applyMavenCentralRules>
                                                <sign>true</sign>
                                                <checksums>true</checksums>
                                                <sourceJar>true</sourceJar>
                                                <javadocJar>true</javadocJar>
                                                <verifyPom>true</verifyPom>
                                            </sonatype>
                                        </mavenCentral>
                                    </maven>
                                </deploy>
                            </jreleaser>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <!--
          JMH overhead benchmarks (docs/benchmarks.md). Never installed or deployed; JMH (GPLv2 + Classpath Exception)
          is a development-time tool only. Normal and release builds never include the module.
            mvn -B -ntp -Pbenchmarks package -DskipTests -Dinvoker.skip -pl springtune-benchmarks -am
            java -jar springtune-benchmarks/target/benchmarks.jar -prof gc
        -->
        <profile>
            <id>benchmarks</id>
            <modules>
                <module>springtune-benchmarks</module>
            </modules>
        </profile>
    </profiles>
</project>
