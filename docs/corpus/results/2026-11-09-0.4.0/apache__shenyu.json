  "findings" : [ {
    "ruleId" : "ST-HIKARI-002",
    "severity" : "WARNING",
    "module" : "shenyu-admin",
    "subject" : "spring.datasource.hikari.leak-detection-threshold",
    "location" : {
      "path" : "shenyu-admin/src/main/resources/application-h2.yml",
      "line" : 1,
      "column" : 0
    },
    "message" : "leakDetectionThreshold is not set (HikariCP default 0 = disabled).",
    "why" : "A connection that is borrowed and never returned shrinks the pool permanently. Without leak detection the first symptom is pool exhaustion in production, with no stack trace pointing at the code that leaked.",
    "fix" : "Set spring.datasource.hikari.leak-detection-threshold slightly above your longest legitimate connection hold time, e.g. 30000-60000 ms. HikariCP then logs the borrowing stack trace.",
    "suppressed" : false
  }, {
    "ruleId" : "ST-TX-001",
    "severity" : "INFO",
    "module" : "shenyu-admin",
    "subject" : "spring.transaction.default-timeout",
    "location" : {
      "path" : "shenyu-admin/src/main/resources/application-h2.yml",
      "line" : 1,
      "column" : 0
    },
    "message" : "No transaction or query timeout is configured: a slow query holds its pooled connection for as long as the database lets it run.",
    "why" : "Long-running queries keep connections checked out. A handful of them is enough to drain the pool, and then every other request waits in connectionTimeout.",
    "fix" : "Set spring.transaction.default-timeout (e.g. 30s) and/or a JDBC query timeout (spring.jdbc.template.query-timeout, or jakarta.persistence.query.timeout for JPA).",
    "suppressed" : false
  }, {
    "ruleId" : "ST-HIKARI-001",
    "severity" : "WARNING",
    "module" : "shenyu-admin",
    "subject" : "spring.datasource.hikari.connection-timeout",
    "location" : {
      "path" : "shenyu-admin/src/main/resources/application-h2.yml",
      "line" : 29,
      "column" : 27
    },
    "message" : "connectionTimeout is 30000 ms, above the 5000 ms threshold.",
    "why" : "When the pool is exhausted, every request thread blocks for up to connectionTimeout before failing. A long wait turns a brief database slowdown into a stalled thread pool and timeouts in every upstream caller.",
    "fix" : "Set spring.datasource.hikari.connection-timeout below your upstream request timeout, at most 5000 ms (e.g. 2000-5000).",
    "suppressed" : false
  }, {
    "ruleId" : "ST-ASYNC-002",
    "severity" : "WARNING",
    "module" : "shenyu-examples/shenyu-examples-http",
    "subject" : "HttpServerConfig#scheduler:ThreadPoolExecutor",
    "location" : {
      "path" : "shenyu-examples/shenyu-examples-http/src/main/java/org/apache/shenyu/examples/http/config/HttpServerConfig.java",
      "line" : 55,
      "column" : 38
    },
    "message" : "ThreadPoolExecutor is created with a LinkedBlockingQueue/Deque without capacity.",
    "why" : "Without a bound, a slow downstream turns into unlimited queued work (memory growth, unbounded latency, lost tasks on restart) or unlimited threads (CPU and memory exhaustion). Nothing pushes back on the caller.",
    "fix" : "Pass a capacity, e.g. new ArrayBlockingQueue<>(n) or new LinkedBlockingQueue<>(n), and a RejectedExecutionHandler.",
    "suppressed" : false
  }, {
    "ruleId" : "ST-ASYNC-002",
