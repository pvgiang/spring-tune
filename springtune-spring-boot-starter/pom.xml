<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>io.github.winkytek.springtune</groupId>
        <artifactId>springtune-parent</artifactId>
        <version>0.3.0-SNAPSHOT</version>
    </parent>

    <artifactId>springtune-spring-boot-starter</artifactId>
    <name>SpringTune :: Spring Boot Starter</name>
    <description>Drop-in starter: /actuator/tuning with knobs, signals, explained recommendations and apply plans. Read-only unless springtune.mode=apply (experimental, guarded).</description>
    <!-- Explicit, not inherited: Maven Central's POM check wants <url> in every published POM. -->
    <url>https://github.com/pvgiang/spring-tune</url>

    <dependencies>
        <dependency>
            <groupId>io.github.winkytek.springtune</groupId>
            <artifactId>springtune-spring-boot-autoconfigure</artifactId>
        </dependency>
        <!-- Actuator provides the endpoint infrastructure and Micrometer (HikariCP hold-time metrics). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!-- No sources here, so maven-source/javadoc-plugin create nothing; Maven Central still requires both jars. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-jar-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>placeholder-sources</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>sources</classifier>
                                    <classesDirectory>${project.basedir}/src/release</classesDirectory>
                                </configuration>
                            </execution>
                            <execution>
                                <id>placeholder-javadoc</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                                <configuration>
                                    <classifier>javadoc</classifier>
                                    <classesDirectory>${project.basedir}/src/release</classesDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
